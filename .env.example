# Copy to .env and fill in. Never commit .env.

# Salt for irreversible session hashes (set your own random string).
POWER_HASH_SALT=change-me

# Optional: override repository root detection.
# POWER_ROOT=

# --- used by later phases (API / worker / web / MCP) ---
DATABASE_URL=postgresql+asyncpg://power:power@localhost:5432/power
MODEL_VERSION=latest
SIM_MODE=REPLAY
ADMIN_TOKEN=
MCP_READONLY_TOKEN=
ACN_API_TOKEN=
OCM_API_KEY=
OPEN_METEO_BASE=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE=https://archive-api.open-meteo.com/v1
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
SEED=42
