# Copy to .env and fill in. Never commit .env.

# Salt for irreversible session hashes (set your own random string).
POWER_HASH_SALT=change-me

# Optional: override repository root detection.
# POWER_ROOT=

# --- backend (power-api) ---
# Empty DATABASE_URL = SQLite at data/power.db. PostgreSQL (docker compose up -d db):
# postgresql+asyncpg://power:power@127.0.0.1:5433/power
DATABASE_URL=
MODEL_VERSION=
POWER_CHAMPION=M4_lightgbm_quantile
SIM_MODE=REPLAY
# Live console city (configs/deployments/<name>.yaml); "none" serves the training sites
POWER_DEPLOYMENT=pune
SIM_START=
POWER_EMBEDDED_WORKER=true
POWER_HISTORY_HOURS=720
CORS_ORIGINS=http://localhost:3011
ADMIN_TOKEN=
MCP_READONLY_TOKEN=
ACN_API_TOKEN=
OCM_API_KEY=
OPEN_METEO_BASE=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE=https://archive-api.open-meteo.com/v1
# Web Push (base64url P-256). Empty = generated once into data/vapid.json. VAPID_SUBJECT: mailto: or https: contact
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
POWER_PUSH=true
# In-app copilot (on the MCP service). Empty key = copilot off. The token guards the copilot route.
GROQ_API_KEY=
POWER_COPILOT_TOKEN=change-me-too
POWER_COPILOT_MODEL=claude-opus-5-5
POWER_COPILOT_EFFORT=low
POWER_MCP_URL=http://127.0.0.1:8765
NEXT_PUBLIC_API_URL=http://localhost:8011
SEED=42

# --- docker compose ---
POSTGRES_PASSWORD=power
POWER_TORCH=cpu          # cpu | none (serve without the LSTM)
POWER_WEB_PORT=3011
POWER_API_PORT=8011
POWER_DB_PORT=5433
POWER_MCP_PORT=8765
POWER_DISCOVERY=true
